# Supabase (Project Settings > API). Local dev: run `supabase status` to get these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for webhooks and seeding.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for auth redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (TEST MODE keys only), used from step 5
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
